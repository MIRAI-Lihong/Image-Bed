# ==================================================================
# 环境变量示例
#
# 使用方式：
#   - 本地开发：复制为 .env（已被 .gitignore 忽略，不会提交）
#   - 生产环境：配置到 Netlify 站点的 Environment variables
#
# 重要约束（详见 AGENTS.md）：
#   1. 本文件只允许存放变量名和示例假值，禁止填入真实密钥
#   2. 长期 AccessKey / Secret 只允许存在于 Netlify 环境变量或本地 .env，
#      禁止进入前端代码、VITE_* 变量、测试样例、日志和仓库
#   3. 前端变量必须以 VITE_ 开头，且值必须可公开（会被打入构建产物）
#   4. 服务端变量不得以 VITE_ 开头，只能由 Netlify Functions 读取
#   5. 环境变量缺失时服务端必须显式报错，不允许静默降级
# ==================================================================

# ---------- 服务端变量（仅 Netlify Functions 读取）----------

# 阿里云 RAM 身份长期密钥（下方均为示例假值）
# 该 RAM 身份应只具备 STS 假设角色 / 限定的 OSS 权限，不使用主账号密钥
ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI5tEXAMPLEexampleEXAMPLE
ALIBABA_CLOUD_ACCESS_KEY_SECRET=EXAMPLEexampleEXAMPLEexampleEXAMPLEexample

# OSS 配置（非敏感，用于构造 STS 策略与签名）
# 地域，例如 oss-cn-hangzhou
OSS_REGION=oss-cn-hangzhou
# Bucket 名称
OSS_BUCKET=example-bucket
# 上传对象强制前缀：临时凭证只允许写入该前缀，用于限制可上传的对象范围
OSS_UPLOAD_PREFIX=uploads/
# STS AssumeRole 目标角色 ARN（该角色的权限策略应限定到上述 Bucket 与前缀的 oss:PutObject）
ALIBABA_CLOUD_STS_ROLE_ARN=acs:ram::0000000000000000:role/example-role

# ---------- 前端变量（VITE_ 前缀，值会进入浏览器，禁止放置任何密钥）----------

# 当前前端不需要任何 VITE_* 变量：
# OSS Bucket / Region 等信息由授权接口随 STS 临时凭证一并下发。
# 未来如需新增前端变量，必须先确认该值可以完全公开。
